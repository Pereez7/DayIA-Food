{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAYIA FOOD — SPK-PRINT-001",
  "version": "0.1.0",
  "identifier": "com.dayiafood.spk-print-001",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DAYIA FOOD — SPK-PRINT-001",
        "width": 720,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Disposable runtime bootstrap for SPK-PRINT-001",
    "longDescription": "Technical bootstrap only. It has no printing, server or production capabilities.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
